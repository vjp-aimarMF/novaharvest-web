@page "/ticket"
@model TicketModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@Model.PageTitle</title>
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <h1>@Model.PageTitle</h1>

    <p>Reserva: @Model.ReservationNumber</p>
    <p>Producto: @Model.Product</p>
    <p>Kilos: @Model.Kilograms</p>
    <p>Recogida: @Model.PickupLocation</p>
    <p>Generado el @Model.GeneratedAt.ToString("dd/MM/yyyy HH:mm")</p>
</body>
</html>