@inject IWebHostEnvironment Env
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - NovaHarvest</title>
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <header>
        <img src="/img/logo.png" alt="Logotipo de NovaHarvest" />
        <strong>NovaHarvest</strong>

        <nav>
            <a href="/">Inicio</a>
            <a href="/surplus">Excedente</a>
            <a href="/about">Acerca de</a>
            <a href="/status">Estado</a>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        NovaHarvest · IES Valle del Jerte · @DateTime.Now.Year · Entorno: @Env.EnvironmentName
    </footer>
</body>
</html>